# ============================================
# SERVIDOR
# ============================================
# Puerto
PORT=5000

# ============================================
# BASE DE DATOS
# ============================================
# Host (localhost XAMPP local)
DB_HOST=localhost

# Puerto (3306 XAMPP)
DB_PORT=3306

# Usuario (root XAMPP)
DB_USER=root

# Contraseña (contraseña XAMPP)
DB_PASSWORD=

# Nombre bd
DB_NAME=sistema_eventos_catering

# ============================================
# JWT (Autenticación)
# ============================================
# Clave secreta para firmar los tokens JWT
# usar la misma que en el script SQL
JWT_SECRET=ClaveSeguraParaEventosPeru2024!

# Tiempo expiración token (7d = 7 días)
JWT_EXPIRES_IN=7d

# ============================================
# CORS (Opcional - para producción)
# ============================================
# Dominios permitidos para CORS (separados por coma)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# ENTORNO (Opcional)
# ============================================
# development | production | test
NODE_ENV=development